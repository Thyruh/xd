import "std.ascii";
import "std.conv";

print_bases :: (u64 number) {
	println("    dec:  %",   number);
	println("    hex:  %",   hex_upper(number));
	println("    bin:  %",   bin(number));
	println("    oct:  %",   oct(number));
	if (is_printable((char)number)) {
		println("    asc:  '%'", (char) number);
	}
}

main :: (string[] args) {
	if (args.length() < 2) {
		println("Interactive mode is implemented but poorly (evidently).");
	}
	for (usize i = 1; i < args.length(); i++) {
		if (args.length() > 2) println("%:", i);
		if (args[i].length == 1 && is_num(args[i][0])) {
			print_bases((u64)(args[i][0]-'0'));
			continue;
		}
		else if (args[i].length == 1) {
			print_bases((u64)args[i][0]);
			continue;
		}
		u64 arg = to_u64(args[i]);
		if arg == U64_MAX {
			println("Wrong argument.");
			continue;
		}
		print_bases(arg);
	}
}
